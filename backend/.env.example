# Database
DATABASE_URL="postgresql://zig_grid:replace-with-a-strong-password@localhost:5432/zig_grid_engine"

# JWT
JWT_SECRET="your-long-random-jwt-secret"
JWT_EXPIRES_IN="7d"

# Encryption key - 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-hex-char-encryption-key"
ENCRYPTION_KEY_PREV=""

# App - binds to loopback only; a reverse proxy (or SSH tunnel) is the only way in.
PORT=3069
HOST=127.0.0.1
TRUST_PROXY=
NODE_ENV=development
COOKIE_SECURE=false
REQUIRE_IP_WHITELIST=true
TRADING_ENABLED=false
MAX_ORDER_USDT=100
MAX_DAILY_USDT=500
MAX_PRICE_DEVIATION_PCT=10
MAX_SLIPPAGE_PCT=2

# Public origin of the site. With a domain: https://your.domain
APP_ORIGIN=http://127.0.0.1:3070
# Optional extra CORS origins (comma-separated); defaults to APP_ORIGIN
ALLOWED_ORIGINS=

# Bybit WebSocket host (alternate: wss://stream.bytick.com where stream.bybit.com is blocked)
BYBIT_WS_HOST=wss://stream.bybit.com
