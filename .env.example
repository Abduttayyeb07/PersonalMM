# ── Public address ────────────────────────────────────────────────────────────
# The ONE place the site's address lives. Change this when you get a domain.
#   No domain yet : APP_ORIGIN=http://127.0.0.1:3070   (reach it from this machine / an SSH tunnel)
#   With a domain : APP_ORIGIN=https://your.domain      (TLS terminated by your reverse proxy)
APP_ORIGIN=http://127.0.0.1:3070

# Browser-facing API / socket URLs (baked into the frontend at build time).
#   Domain mode   : leave BOTH empty -> same origin; proxy routes /api and /socket.io to 127.0.0.1:3069
#   No-domain mode: use the loopback backend port below
NEXT_PUBLIC_API_URL=http://127.0.0.1:3069/api
NEXT_PUBLIC_WS_URL=http://127.0.0.1:3069

# Extra allowed CORS origins (comma-separated). Defaults to APP_ORIGIN when empty.
ALLOWED_ORIGINS=
# Number of reverse-proxy hops to trust for the client IP (1 behind nginx/caddy; empty without a proxy).
TRUST_PROXY=

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=zig_grid
POSTGRES_PASSWORD=tayyeb1234
POSTGRES_DB=zig_grid_engine

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key
ENCRYPTION_KEY_PREV=

# The compose backend runs with NODE_ENV=production, which REQUIRES secure cookies, i.e. HTTPS.
# Without a domain, run outside Docker in development mode instead (see docs/run-without-docker.md)
# or set up a domain + TLS first.
COOKIE_SECURE=true
REQUIRE_IP_WHITELIST=true
TRADING_ENABLED=false
MAX_ORDER_USDT=100
MAX_DAILY_USDT=500
MAX_PRICE_DEVIATION_PCT=10
MAX_SLIPPAGE_PCT=2

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
