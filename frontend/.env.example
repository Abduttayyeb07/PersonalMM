# Used by `next build` / `next start` when running WITHOUT Docker (copy to .env.local).
# Domain mode (reverse proxy routes /api and /socket.io to the backend): leave both empty
# and the browser talks to the site's own origin.
# Local mode (no domain, no proxy): point straight at the loopback backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3069/api
NEXT_PUBLIC_WS_URL=http://127.0.0.1:3069
