# ── Secrets: never commit ─────────────────────────────────────────────────────
# Real environment files hold JWT/encryption keys and database passwords.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── Dependencies and build output ─────────────────────────────────────────────
node_modules/
dist/
build/
out/
.next/
.next-dev/
coverage/
*.tsbuildinfo
next-env.d.ts

# ── Engine runtime data (backtest candles, reports, audit output) ─────────────
backend/engine-data/

# ── Logs and local tooling ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
graphify-out/
.graphify_python

# ── Internal documents (keep out of the repository) ───────────────────────────
*.docx
*.pdf

# ── OS and editors ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
